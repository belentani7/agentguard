# agentguard - Environment Variables
# Copia a .env y rellena los valores

# Database
POSTGRES_DB=agentguard
POSTGRES_USER=agentguard
POSTGRES_PASSWORD=cambia_esto_en_produccion

# Security - GENERA UNO NUEVO: openssl rand -base64 32
SECRET_KEY=dev-secret-key-cambia-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Stripe (consigue en https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta
STRIPE_PUBLISHABLE_KEY=pk_test_tu_clave_publica
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret

# Stripe Price IDs (crea productos en Stripe Dashboard > Products)
STRIPE_PRICE_ID_MONTHLY=price_id_mensual
STRIPE_PRICE_ID_YEARLY=price_id_anual
STRIPE_PRICE_ID_ENTERPRISE=price_id_enterprise

# Frontend
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development